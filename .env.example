# Anthropic API — same settings used for ALL agents and the baseline
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-3-5-20241022
ANTHROPIC_TEMPERATURE=0
ANTHROPIC_MAX_TOKENS=1024

# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tier1_tickets
POSTGRES_USER=tier1_user
POSTGRES_PASSWORD=change-this-password

# GitHub API
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=flask-buggy-fork

# Experiment logging
LOG_DIR=results/raw_logs
